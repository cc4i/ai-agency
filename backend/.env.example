# Google AI API Keys
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=your-gemini-api-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Configuration
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=pcm_s16le
SAVE_AUDIO_DEBUG=False  # Set to True to save audio chunks for debugging
AUDIO_DEBUG_DIR=/tmp/audio_debug  # Directory to save debug audio files

# Google Cloud Storage
GCS_BUCKET_NAME=ai-agency-demo

# Gemini Live WebSocket URL (Vertex AI)
GEMINI_LIVE_WS_URL=wss://us-central1-aiplatform.googleapis.com/ws/google.cloud.aiplatform.v1beta1.LlmBidiService/BidiGenerateContent

# Memory Bank Configuration (Vertex AI)
# Run `python backend/scripts/setup_memory_bank.py` to create an Agent Engine and get the ID
AGENT_ENGINE_ID=
ENABLE_MEMORY_BANK=false
MEMORY_CALLBACK_ENABLED=false
