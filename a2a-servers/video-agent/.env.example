# A2A Video Agent Configuration

# Server settings
BASE_URL=http://localhost:8001
HOST=0.0.0.0
PORT=8001

# Authentication
API_KEY=your_api_key_here

# CORS settings (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Agent metadata
AGENT_ID=video_producer_a2a
AGENT_NAME=Video Producer Agent
AGENT_DESCRIPTION=A2A-compliant video generation agent. Creates 15-second social media videos from text prompts and brand guidelines.
PROVIDER_NAME=AI Agency
PROVIDER_URL=https://ai-agency.example.com

# Task settings
MOCK_PROCESSING_DELAY=0.8
MOCK_VIDEO_URL=https://storage.example.com/videos/sample.mp4
